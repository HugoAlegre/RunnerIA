<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- TFM Windows: OcrWindows (WinRT). Salida en %LOCALAPPDATA%\RunnerIA\ (Directory.Build.props). -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RunnerIA</RootNamespace>
    <AssemblyName>RunnerIA</AssemblyName>
    <Product>RunnerIA</Product>
    <AssemblyTitle>RunnerIA</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.13" />
    <PackageReference Include="AdoNetCore.AseClient" Version="0.19.2" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

  <Target Name="ExcludePlaywrightSkillDocs"
          BeforeTargets="GetCopyToOutputDirectoryItems;_CopyOutOfDateSourceItemsToOutputDirectory;CopyFilesToOutputDirectory">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="'%(Filename)%(Extension)' != '' AND $([System.String]::Copy('%(Identity)').Contains('playwright-component-testing'))" />
      <ContentWithTargetPath Remove="@(ContentWithTargetPath)" Condition="$([System.String]::Copy('%(Identity)').Contains('playwright-component-testing'))" />
      <ContentWithTargetPath Remove="@(ContentWithTargetPath)" Condition="$([System.String]::Copy('%(Identity)').Contains('.playwright\package\lib\tools\skills'))" />
      <ContentWithTargetPath Remove="@(ContentWithTargetPath)" Condition="$([System.String]::Copy('%(Identity)').Contains('.playwright/package/lib/tools/skills'))" />
    </ItemGroup>
  </Target>

</Project>
