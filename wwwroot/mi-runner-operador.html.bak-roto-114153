      cont.innerHTML = ids.map(function (id) {
        const esc = ESCENARIOS[id];
        if (!esc) return "";
        const sel = id === escenarioActual ? " selected" : "";
        return '<div class="scenario' + sel + '" data-id="' + id + '">' +
