    function abrirSotDialog(opts) {
      const options = opts || {};
      const backdrop = document.getElementById("sotDialog");
      const body = document.getElementById("sotDialogBody");
      const foot = document.getElementById("sotDialogFoot");

      document.getElementById("sotDialogEyebrow").textContent = options.eyebrow || "Runner SOT";
      document.getElementById("sotDialogTitle").textContent = options.title || "Aviso";
      body.innerHTML = options.bodyHtml || "";
      foot.innerHTML = "";

      const modo = options.mode || "alert";
      if (modo === "confirm") {
        const btnCancel = document.createElement("button");
        btnCancel.type = "button";
        btnCancel.textContent = options.cancelLabel || "Cancelar";
        btnCancel.addEventListener("click", function () { cerrarSotDialog(false); });
        foot.appendChild(btnCancel);

        const btnOk = document.createElement("button");
        btnOk.type = "button";
        btnOk.className = "primary";
        btnOk.textContent = options.confirmLabel || "Confirmar";
        btnOk.addEventListener("click", function () { cerrarSotDialog(true); });
        foot.appendChild(btnOk);
        setTimeout(function () { btnOk.focus(); }, 30);
      } else {
        const btnOk = document.createElement("button");
        btnOk.type = "button";
        btnOk.className = "primary";
        btnOk.textContent = options.confirmLabel || "Entendido";
        btnOk.addEventListener("click", function () { cerrarSotDialog(true); });
        foot.appendChild(btnOk);
        setTimeout(function () { btnOk.focus(); }, 30);
      }

      backdrop.classList.add("open");
      backdrop.setAttribute("aria-hidden", "false");

      return new Promise(function (resolve) {
        sotDialogResolver = resolve;
      });
    }

