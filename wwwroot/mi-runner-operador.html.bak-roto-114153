    function setEvidenciaLinksEnabled(enabled, zipUrl, informeUrl) {
      const zip = document.getElementById("btnDescargarZip");
      const inf = document.getElementById("btnAbrirInforme");
      zip.style.display = "inline-flex";
      inf.style.display = "inline-flex";
      if (enabled) {
        zip.href = zipUrl || "#";
        inf.href = informeUrl || "#";
        zip.classList.remove("is-disabled");
        inf.classList.remove("is-disabled");
        zip.setAttribute("aria-disabled", "false");
        inf.setAttribute("aria-disabled", "false");
      } else {
        zip.href = "#";
        inf.href = "#";
        zip.classList.add("is-disabled");
        inf.classList.add("is-disabled");
        zip.setAttribute("aria-disabled", "true");
        inf.setAttribute("aria-disabled", "true");
      }
    }

    function ocultarEvidenciaActions() {
      const box = document.getElementById("evidenciaActions");
      box.style.display = "block";
      box.classList.remove("is-fail");
      document.getElementById("evidenciaActionsTitle").textContent = "Informe y evidencias";
      document.getElementById("evidenciaRuta").textContent =
        "Ejecutá el escenario para generar el informe paso a paso con capturas. Descarga e informe quedan disponibles al terminar.";
      document.getElementById("informeEmbedHint").textContent =
        "Capturas por paso (Hooks). Se omite PNG solo si está duplicado y la config lo permite; sin browser no hay captura.";
      document.getElementById("informeFrame").src = "about:blank";
      setEvidenciaLinksEnabled(false);
      ultimaCorridaMeta = null;
    }

    function mostrarEvidenciaActions(data) {
      ultimaCorridaMeta = data || null;
      const box = document.getElementById("evidenciaActions");
      const fallo = !data || data.ok === false;
      box.style.display = "block";
      box.classList.toggle("is-fail", !!fallo);

      if (!data || !data.tieneEvidencia) {
        document.getElementById("evidenciaActionsTitle").textContent = fallo
          ? "Salió con fallas · Sin carpeta de evidencia"
          : "OK · Sin carpeta de evidencia";
        document.getElementById("evidenciaRuta").textContent = data && data.error
          ? data.error
          : "No se encontró carpeta Ejecucion_* para esta corrida. Abrí Detalle técnico para ver el log.";
        document.getElementById("informeFrame").src = "about:blank";
        document.getElementById("informeEmbedHint").textContent =
          "Sin informe HTML todavía. Los botones de descarga/informe se habilitan cuando hay evidencia.";
        setEvidenciaLinksEnabled(false);
        abrirDetalleTecnico(true);
        return;
      }

      document.getElementById("evidenciaActionsTitle").textContent = fallo
        ? "Salió con fallas · Ver informe"
        : "OK · Informe de la corrida";
      document.getElementById("evidenciaRuta").textContent =
        "También queda en disco: " + (data.evidenciaCarpeta || "");
      const informeUrl = API_BASE + (data.evidenciaInformeUrl || ("/run/" + data.runId + "/informe"));
      const zipUrl = API_BASE + (data.evidenciaZipUrl || ("/run/" + data.runId + "/evidencia.zip"));
      setEvidenciaLinksEnabled(true, zipUrl, informeUrl);
      if (data.evidenciaInforme || data.evidenciaInformeUrl) {
        document.getElementById("informeEmbedHint").textContent = fallo
          ? "Corrida con fallos — revisá capturas y detalle abajo."
          : "Corrida OK — paso a paso con capturas abajo.";
        document.getElementById("informeFrame").src = informeUrl + "?t=" + Date.now();
        setTimeout(function () {
          box.scrollIntoView({ behavior: "smooth", block: "start" });
        }, 200);
      } else {
        document.getElementById("informeFrame").src = "about:blank";
        document.getElementById("informeEmbedHint").textContent =
          "ZIP disponible; no se encontró el HTML Extent de esta corrida.";
        abrirDetalleTecnico(true);
      }
    }

    function ocultarStatus() {
      const bar = document.getElementById("statusBar");
      bar.className = "status-bar";
      bar.textContent = "";
    }

