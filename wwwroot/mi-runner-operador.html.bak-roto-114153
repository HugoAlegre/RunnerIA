      });
    });

    // ---------- Generar con asistente + grupos de testing ----------
    const PILOTO_LS_KEY = "sot-runner-piloto-jira";
    const PILOTO_CAT_ID = "grp-sin-clasificar";
    let pilotoToastTimer = null;
    let pilotoToastEscenarioId = null;
    let pilotoToastGrupoId = null;
    let pilotoGruposCache = [];

    function pilotoEsCategoriaTesting(cat) {
      return !!(cat && (cat.testing || String(cat.id || "").indexOf("grp-") === 0));
    }

    function pilotoLimpiarCategoriasTesting() {
      for (var i = CATEGORIAS.length - 1; i >= 0; i--) {
        if (pilotoEsCategoriaTesting(CATEGORIAS[i])) CATEGORIAS.splice(i, 1);
      }
    }

    function pilotoAsegurarCategoriasDesdeGrupos(grupos) {
      pilotoLimpiarCategoriasTesting();
      pilotoGruposCache = grupos || [];
      if (!pilotoGruposCache.length) {
        pilotoGruposCache = [{ id: PILOTO_CAT_ID, nombre: "Testing (sin clasificar)", sub: "Casos del asistente aún sin grupo" }];
      }
      pilotoGruposCache.forEach(function (g) {
        CATEGORIAS.push({
          id: g.id,
          nombre: g.nombre,
          sub: g.sub || "Grupo de testing",
          escenarios: [],
          testing: true
        });
      });
      pilotoRellenarSelectGrupos();
    }

    function pilotoRellenarSelectGrupos() {
      const sel = document.getElementById("pilotoGrupoSelect");
      if (!sel) return;
      const actual = sel.value;
      sel.innerHTML = (pilotoGruposCache || []).map(function (g) {
        return '<option value="' + escaparAttr(g.id) + '">' + escaparAttr(g.nombre) + "</option>";
      }).join("");
      if (actual && [].some.call(sel.options, function (o) { return o.value === actual; }))
        sel.value = actual;
      else if (sel.options.length)
        sel.value = sel.options[0].value;
    }

    function pilotoActualizarModoGrupo() {
      const esNuevo = !!(document.getElementById("pilotoGrupoModoNuevo") && document.getElementById("pilotoGrupoModoNuevo").checked);
      const boxExistente = document.getElementById("pilotoGrupoExistenteBox");
      const boxNuevo = document.getElementById("pilotoGrupoNuevoBox");
      const sel = document.getElementById("pilotoGrupoSelect");
      const inp = document.getElementById("pilotoGrupoNuevo");
      if (boxExistente) boxExistente.style.display = esNuevo ? "none" : "block";
      if (boxNuevo) boxNuevo.style.display = esNuevo ? "block" : "none";
      if (sel) sel.disabled = esNuevo;
      if (inp) {
        inp.disabled = !esNuevo;
        if (!esNuevo) inp.value = "";
      }
    }

    function pilotoInferirTituloDesdeFeature(featureText) {
      const m = String(featureText || "").match(/^\s*Feature:\s*(.+)$/im);
      if (!m) return "";
      var t = m[1].trim();
      t = t.replace(/^Piloto\s*[—\-–:]?\s*/i, "").replace(/\s*\[[^\]]+\]\s*$/, "").trim();
      return t;
    }

    function pilotoCatPorId(id) {
      return CATEGORIAS.find(function (c) { return c.id === id; });
    }

    function pilotoRegistrarEnCatalogo(b) {
      if (!b || !b.id) return;
      const filterTag = b.filterTag || ("PilotoRun_" + String(b.nombre || "Borrador").replace(/\.feature$/i, "").replace(/[^\w]+/g, "_"));
      const descripcion = (b.descripcion || b.corto || "").trim()
        || ("Caso generado con asistente" + (b.grupoNombre ? (" · grupo «" + b.grupoNombre + "»") : "") + ".");
      ESCENARIOS[b.id] = {
        num: b.id.replace(/^piloto-/, "P-"),
        tipo: "smoke",
        titulo: b.titulo || b.nombre,
        corto: (b.grupoNombre ? (b.grupoNombre + " · ") : "") + (b.corto || TruncarTexto(descripcion, 80) || b.nombre || ""),
        descripcion: descripcion,
        tag: b.tag || ("@Piloto @" + filterTag),
        resultado: "Informe HTML + capturas PNG + ZIP descargable",
        script: "run-PilotoBorrador.ps1",
        extraArgs: "-Feature " + (b.nombre || "") + " -FilterTag " + filterTag,
        piloto: true,
        pilotoArchivo: b.nombre,
        grupoId: b.grupoId || PILOTO_CAT_ID,
        prerequisitos: [
          "Configuración SOT válida (usuario/sucursal)",
          "Caja abierta del tipo/moneda indicada (ej. Normal | U$S)",
          "Capturas: Hooks AfterStep (sí con UI; no si falló antes / sin browser / duplicado omitido)"
        ],
        evidencias: [
          "Informe HTML Extent embebido (paso a paso)",
          "Capturas PNG por paso",
          "Descargar evidencias (ZIP)"
        ]
      };
    }

    function TruncarTexto(t, max) {
      t = String(t || "").trim();
      if (t.length <= max) return t;
      return t.slice(0, max - 1) + "…";
    }

    function pilotoInferirResumenDesdeFeature(featureText) {
      const m = String(featureText || "").match(/^\s*#\s*Resumen:\s*(.+)$/im);
      return m ? m[1].trim() : "";
    }

    function pilotoSincronizarCatalogo(payload) {
      const grupos = payload && payload.grupos ? payload.grupos : [];
      const lista = payload && payload.casos ? payload.casos : (Array.isArray(payload) ? payload : []);
      pilotoAsegurarCategoriasDesdeGrupos(grupos);

      Object.keys(ESCENARIOS).forEach(function (id) {
        if (ESCENARIOS[id] && ESCENARIOS[id].piloto) delete ESCENARIOS[id];
      });
      CATEGORIAS.forEach(function (c) {
        if (pilotoEsCategoriaTesting(c)) c.escenarios = [];
      });

      (lista || []).forEach(function (b) {
        pilotoRegistrarEnCatalogo(b);
        const gid = b.grupoId || PILOTO_CAT_ID;
        let cat = pilotoCatPorId(gid);
        if (!cat) {
          cat = pilotoCatPorId(PILOTO_CAT_ID);
        }
        if (cat) cat.escenarios.push(b.id);
      });

      renderCategorias();
      if (pilotoEsCategoriaTesting(pilotoCatPorId(categoriaActual))) {
        const cat = pilotoCatPorId(categoriaActual);
        if (!cat || !cat.escenarios.length) {
          escenarioActual = CATEGORIAS[0].escenarios[0];
        } else if (cat.escenarios.indexOf(escenarioActual) === -1) {
          escenarioActual = cat.escenarios[0];
        }
        renderLista();
        if (ESCENARIOS[escenarioActual]) mostrarEscenario(ESCENARIOS[escenarioActual]);
      } else {
        renderLista();
      }
    }

    async function pilotoCargarEnRunner(irAlEscenarioId, irAlGrupoId) {
      if (!servidorOnline) return null;
      try {
        const res = await fetch(API_BASE + "/piloto/escenarios", { cache: "no-store" });
        const data = await res.json();
        pilotoSincronizarCatalogo(data);
        if (irAlEscenarioId && ESCENARIOS[irAlEscenarioId]) {
          categoriaActual = irAlGrupoId || ESCENARIOS[irAlEscenarioId].grupoId || PILOTO_CAT_ID;
          escenarioActual = irAlEscenarioId;
          renderCategorias();
          renderLista();
          mostrarEscenario(ESCENARIOS[escenarioActual]);
          cambiarVista("runner");
        }
        return data;
      } catch (err) {
        console.warn("pilotoCargarEnRunner", err);
        return null;
      }
    }

    function pilotoMostrarToast(titulo, sub, escenarioId, grupoId) {
      const toast = document.getElementById("pilotoToast");
      document.getElementById("pilotoToastTitle").textContent = titulo || "Se creó correctamente";
      document.getElementById("pilotoToastSub").textContent = sub || "Ya está en el Runner · grupo de testing";
      pilotoToastEscenarioId = escenarioId || null;
      pilotoToastGrupoId = grupoId || null;
      toast.classList.add("visible");
      toast.setAttribute("aria-hidden", "false");
      if (pilotoToastTimer) clearTimeout(pilotoToastTimer);
      pilotoToastTimer = setTimeout(function () {
        toast.classList.remove("visible");
        toast.setAttribute("aria-hidden", "true");
        pilotoToastTimer = null;
      }, 2000);
    }

    document.getElementById("pilotoToastVer").addEventListener("click", function () {
      const id = pilotoToastEscenarioId;
      const gid = pilotoToastGrupoId;
      if (pilotoToastTimer) { clearTimeout(pilotoToastTimer); pilotoToastTimer = null; }
      document.getElementById("pilotoToast").classList.remove("visible");
      if (id) pilotoCargarEnRunner(id, gid);
      else {
        categoriaActual = gid || PILOTO_CAT_ID;
        cambiarVista("runner");
        renderCategorias();
        renderLista();
      }
    });

    function pilotoMostrarStatus(msg, tipo) {
      const bar = document.getElementById("pilotoStatus");
      if (!bar) return;
      bar.textContent = msg || "";
      bar.className = "status-bar visible " + (tipo || "info");
    }

    function pilotoListaHtml(items, vacio) {
      if (!items || !items.length) return "<li style=\"color:var(--muted)\">" + (vacio || "Ninguno") + "</li>";
      return items.map(function (x) { return "<li>" + String(x).replace(/</g, "&lt;") + "</li>"; }).join("");
    }

    function pilotoCargarCredencialesLocales() {
      try {
        const raw = localStorage.getItem(PILOTO_LS_KEY);
        if (!raw) return;
        const o = JSON.parse(raw);
        if (o.email) document.getElementById("pilotoJiraEmail").value = o.email;
        if (o.token) document.getElementById("pilotoJiraToken").value = o.token;
        document.getElementById("pilotoRememberJira").checked = true;
      } catch (e) {}
    }

    function pilotoGuardarCredencialesLocalesSiCorresponde() {
      const remember = document.getElementById("pilotoRememberJira").checked;
      if (!remember) {
        try { localStorage.removeItem(PILOTO_LS_KEY); } catch (e) {}
        return;
      }
      try {
        localStorage.setItem(PILOTO_LS_KEY, JSON.stringify({
          email: document.getElementById("pilotoJiraEmail").value || "",
          token: document.getElementById("pilotoJiraToken").value || ""
        }));
      } catch (e) {}
    }

    async function pilotoRefrescarBorradores() {
      const cont = document.getElementById("pilotoListaBorradores");
      if (!cont) return;
      if (!servidorOnline) {
        cont.innerHTML = "Servidor offline. Iniciá Iniciar-Runner.bat.";
        return;
      }
      try {
        const res = await fetch(API_BASE + "/piloto/escenarios", { cache: "no-store" });
        const data = await res.json();
        pilotoSincronizarCatalogo(data);
        const casos = data.casos || [];
        if (!casos.length) {
          cont.innerHTML = "Todavía no hay casos. Generá uno con el asistente y asignalo a un grupo.";
          return;
        }
        cont.innerHTML = casos.map(function (b) {
          return "<div style=\"display:flex; justify-content:space-between; gap:10px; align-items:center; margin-bottom:6px;\">" +
            "<span><strong>" + escaparHtml(b.grupoNombre || "—") + "</strong> · <code>" + escaparHtml(b.nombre) + "</code> · " + escaparHtml(b.titulo || "") + "</span>" +
            "<button type=\"button\" class=\"danger-outline piloto-del-lista\" data-nombre=\"" + escaparHtml(b.nombre) + "\">Eliminar</button>" +
            "</div>";
        }).join("");
        cont.querySelectorAll(".piloto-del-lista").forEach(function (btn) {
          btn.addEventListener("click", function () {
            pilotoEliminarBorrador(btn.getAttribute("data-nombre"));
          });
        });
      } catch (err) {
        cont.innerHTML = "No se pudo listar: " + err.message;
      }
    }

    async function pilotoEliminarBorrador(nombre) {
      if (!nombre) return;
      const ok = await abrirSotDialog({
        mode: "confirm",
        eyebrow: "Grupos de testing",
        title: "¿Eliminar caso?",
        confirmLabel: "Eliminar",
        cancelLabel: "Cancelar",
        bodyHtml: "<p>Se quitará del Runner/grupo y se borrará <code>" + escHtml(nombre) + "</code>.</p>"
      });
      if (!ok) return;
      try {
        const res = await fetch(API_BASE + "/piloto/borradores/" + encodeURIComponent(nombre), { method: "DELETE" });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          mostrarStatus(data.error || "No se pudo eliminar.", "error");
          pilotoMostrarStatus(data.error || "No se pudo eliminar.", "error");
          return;
        }
        await pilotoCargarEnRunner(null);
        await pilotoRefrescarBorradores();
        mostrarStatus("Caso eliminado.", "ok");
        pilotoMostrarStatus("Caso eliminado del grupo de testing.", "ok");
      } catch (err) {
        mostrarStatus("Error: " + err.message, "error");
      }
    }

    document.getElementById("btnEliminarPiloto").addEventListener("click", function () {
      const esc = ESCENARIOS[escenarioActual];
      if (!esc || !esc.piloto || !esc.pilotoArchivo) return;
      pilotoEliminarBorrador(esc.pilotoArchivo);
    });

    document.getElementById("btnPilotoAnalizar").addEventListener("click", async function () {
      if (!servidorOnline) {
        pilotoMostrarStatus("Servidor offline. Abrí Iniciar-Runner.bat y recargá.", "error");
        return;
      }
      pilotoGuardarCredencialesLocalesSiCorresponde();
      var textoBase = (document.getElementById("pilotoTexto").value || "").trim();
      var monedaSel = (document.getElementById("pilotoMoneda") && document.getElementById("pilotoMoneda").value || "").trim();
      var importeSel = (document.getElementById("pilotoImporte") && document.getElementById("pilotoImporte").value || "").trim();
      var extras = [];
      if (monedaSel) extras.push("Moneda de caja: " + monedaSel + " (selector UI Normal | " + (monedaSel === "Pesos" ? "$" : monedaSel === "Euro" ? "€" : "U$S") + ").");
      if (importeSel) extras.push("Importe fijo: " + importeSel + ". Cargar importe " + importeSel + ".");
      if (!/otros ingresos/i.test(textoBase) && (monedaSel || importeSel))
        extras.unshift("Otros Ingresos.");
      var textoManual = [textoBase].concat(extras).filter(Boolean).join("\n");

      const fd = new FormData();
      fd.append("tituloSugerido", document.getElementById("pilotoTitulo").value || "");
      fd.append("jiraUrl", document.getElementById("pilotoJiraUrl").value || "");
      fd.append("jiraEmail", document.getElementById("pilotoJiraEmail").value || "");
      fd.append("jiraToken", document.getElementById("pilotoJiraToken").value || "");
      fd.append("textoManual", textoManual);
      const files = document.getElementById("pilotoFiles").files;
      for (var i = 0; i < files.length; i++) fd.append("files", files[i]);

      pilotoMostrarStatus("Analizando fuentes y steps del proyecto…", "info");
      document.getElementById("btnPilotoAnalizar").disabled = true;
      try {
        const res = await fetch(API_BASE + "/piloto/analizar", { method: "POST", body: fd });
        const data = await res.json();
        if (!res.ok || data.ok === false) {
          pilotoMostrarStatus(data.error || "No se pudo analizar.", "error");
          return;
        }
        document.getElementById("pilotoResultado").style.display = "block";
        document.getElementById("pilotoVeredicto").textContent = data.veredicto || "—";
        document.getElementById("pilotoPuede").textContent = data.puedeGenerar ? "Sí (revisar)" : "No — falta info";
        document.getElementById("pilotoResumen").textContent = data.resumen || "";
        document.getElementById("pilotoFaltantes").innerHTML = pilotoListaHtml(data.faltantes, "Nada crítico detectado");
        const riesgos = [].concat(data.riesgos || [], data.avisos || [], data.hallazgos || []);
        document.getElementById("pilotoRiesgos").innerHTML = pilotoListaHtml(riesgos, "Sin avisos");
        document.getElementById("pilotoSteps").innerHTML = pilotoListaHtml(data.stepsReutilizables, "Ninguno detectado");
        document.getElementById("pilotoFeature").value = data.featureBorrador || "";
        const tituloCaso = document.getElementById("pilotoTituloCaso");
        if (tituloCaso) {
          tituloCaso.value = (document.getElementById("pilotoTitulo").value || "").trim()
            || pilotoInferirTituloDesdeFeature(data.featureBorrador || "")
            || "Caso piloto";
        }
        const resumenCaso = document.getElementById("pilotoResumenCaso");
        if (resumenCaso) {
          resumenCaso.value = (data.descripcionCaso || "").trim()
            || pilotoInferirResumenDesdeFeature(data.featureBorrador || "")
            || "";
        }
        pilotoActualizarModoGrupo();
        const ticketMatch = (document.getElementById("pilotoJiraUrl").value || "").match(/([A-Z][A-Z0-9]+-\d+)/);
        if (!document.getElementById("pilotoNombreArchivo").value) {
          document.getElementById("pilotoNombreArchivo").value = ticketMatch
            ? "Piloto_" + ticketMatch[1] + ".feature"
            : "Piloto_" + new Date().toISOString().slice(0, 19).replace(/[:T]/g, "_") + ".feature";
        }
        await fetch(API_BASE + "/piloto/grupos", { cache: "no-store" })
          .then(function (r) { return r.json(); })
          .then(function (grupos) { pilotoAsegurarCategoriasDesdeGrupos(grupos); })
          .catch(function () {});
        const tipo = data.veredicto === "falta_info" ? "warn" : (data.veredicto === "crear" ? "ok" : "info");
        pilotoMostrarStatus("Análisis listo: " + data.veredicto + ". Elegí el grupo de testing y guardá.", tipo);
      } catch (err) {
        pilotoMostrarStatus("Error: " + err.message, "error");
      } finally {
        document.getElementById("btnPilotoAnalizar").disabled = false;
      }
    });

    document.getElementById("btnPilotoGuardar").addEventListener("click", async function () {
      if (!servidorOnline) {
        pilotoMostrarStatus("Servidor offline.", "error");
        return;
      }
      const contenido = document.getElementById("pilotoFeature").value || "";
      const nombre = document.getElementById("pilotoNombreArchivo").value || "";
      const forzar = document.getElementById("pilotoForzarIncompleto").checked;
