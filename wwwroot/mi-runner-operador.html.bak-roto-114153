    async function verificarServidor() {
      try {
        const res = await fetch(API_BASE + "/health", { cache: "no-store" });
        if (!res.ok) throw new Error("health");
        const wasOffline = !servidorOnline;
        servidorOnline = true;
        setServerState(corridaEnCurso ? "busy" : "online", corridaEnCurso
          ? "Servidor: corrida en curso"
          : "Servidor: conectado (localhost:5050)");
        if (wasOffline) pilotoCargarEnRunner(null);
      } catch (_) {
        servidorOnline = false;
        setServerState("offline", "Servidor: sin conexión — doble clic en Iniciar-Runner.bat");
      }
    }

    function setEjecutando(enCurso) {
      corridaEnCurso = enCurso;
      document.getElementById("btnEjecutar").disabled = enCurso;
      if (enCurso) {
        setServerState("busy", "Servidor: corrida en curso");
      } else {
        verificarServidor();
      }
    }

    let ultimaCorridaMeta = null;

    function setRunProgress(fase, tituloEscenario, subtitulo) {
      const box = document.getElementById("runProgress");
      const spin = document.getElementById("runProgressSpin");
      const glyph = document.getElementById("runProgressGlyph");
      const actions = document.getElementById("runProgressActions");
      const fold = document.getElementById("runLogFold");

      if (!fase || fase === "idle") {
        box.className = "run-progress";
        box.setAttribute("aria-hidden", "true");
        actions.className = "run-progress-actions";
        fold.className = "run-log-fold";
        fold.open = false;
        return;
      }

      const fases = {
        loading: {
          phase: "Cargando ejecución",
          title: tituloEscenario || "Preparando corrida…",
          sub: subtitulo || "Iniciando Playwright y el script del escenario.",
          glyph: "",
          spinning: true
        },
        running: {
          phase: "En ejecución",
          title: tituloEscenario || "Corrida en curso…",
          sub: subtitulo || "La prueba está corriendo. Podés seguir el avance cuando termine.",
          glyph: "",
          spinning: true
        },
        ok: {
          phase: "Finalizó",
          title: "OK",
          sub: subtitulo || "La corrida terminó correctamente. Revisá el informe si querés el detalle.",
          glyph: "✓",
          spinning: false
        },
        fail: {
          phase: "Finalizó",
          title: "Salió con fallas",
          sub: subtitulo || "Revisá el informe para ver el paso a paso y las capturas.",
          glyph: "!",
          spinning: false
        }
      };

      const cfg = fases[fase] || fases.running;
      box.className = "run-progress visible " + fase;
      box.setAttribute("aria-hidden", "false");
      document.getElementById("runProgressPhase").textContent = cfg.phase;
      document.getElementById("runProgressTitle").textContent = cfg.title;
      document.getElementById("runProgressSub").textContent = cfg.sub;

      spin.style.display = cfg.spinning ? "block" : "none";
      glyph.style.display = cfg.spinning ? "none" : "inline";
      glyph.textContent = cfg.glyph;

      const mostrarAcciones = fase === "ok" || fase === "fail";
      actions.className = "run-progress-actions" + (mostrarAcciones ? " visible" : "");
      fold.className = "run-log-fold" + (mostrarAcciones ? " visible" : "");
      if (!mostrarAcciones) fold.open = false;
    }

    function abrirDetalleTecnico(forzarAbrir) {
      const fold = document.getElementById("runLogFold");
      const panel = document.getElementById("logPanel");
      if (!fold) return;
      fold.className = "run-log-fold visible";
      if (panel && panel.textContent) panel.className = "log-panel visible";
      if (forzarAbrir) fold.open = true;
      fold.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function mostrarLog(texto) {
      const panel = document.getElementById("logPanel");
      const fold = document.getElementById("runLogFold");
      if (!texto) {
        panel.className = "log-panel";
        panel.textContent = "";
        return;
      }
      panel.className = "log-panel visible";
      panel.textContent = texto;
      if (fold) fold.className = "run-log-fold visible";
      panel.scrollTop = panel.scrollHeight;
    }

