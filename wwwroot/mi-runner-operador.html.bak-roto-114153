            "<pre class=\"sot-dialog-code\">" + escHtml(comandoPowerShell(esc)) + "</pre>"
        });
        return;
      }

      if (corridaEnCurso) return;

      const confirmar = await abrirSotDialog({
        mode: "confirm",
        eyebrow: "Ejecutar corrida",
        title: "Escenario " + esc.num,
        confirmLabel: "Ejecutar",
        cancelLabel: "Cancelar",
        bodyHtml:
          "<p>" + escHtml(esc.titulo) + "</p>" +
          "<div class=\"sot-dialog-meta\">" +
          "<div><span class=\"lbl\">Script</span><span class=\"val\">" + escHtml(esc.script) + "</span></div>" +
          (esc.extraArgs
            ? "<div><span class=\"lbl\">Args</span><span class=\"val\">" + escHtml(esc.extraArgs) + "</span></div>"
            : "") +
          "<div><span class=\"lbl\">Tag</span><span class=\"val\">" + escHtml(esc.tag) + "</span></div>" +
          "</div>" +
          "<p class=\"sot-dialog-hint\">Puede tardar varios minutos (Playwright + SOT). El log se muestra en vivo abajo.</p>"
      });
      if (!confirmar) return;

      setEjecutando(true);
      ocultarStatus();
      mostrarLog("");
      ocultarEvidenciaActions();
      setRunProgress("loading", esc.titulo, "Preparando la corrida…");

      try {
        const res = await fetch(API_BASE + "/run/" + escenarioActual, { method: "POST" });
        const data = await res.json();

        if (res.status === 409) {
          setEjecutando(false);
          setRunProgress("idle");
          mostrarStatus(data.error || "Ya hay una corrida en curso.", "warn");
          return;
        }
        if (!res.ok && res.status !== 202) {
          setEjecutando(false);
          const errMsg = data.error || ("No se pudo iniciar la corrida (HTTP " + res.status + ").");
          mostrarLog(errMsg + "\n\nSi el escenario es nuevo (ej. 30), cerrá la ventana negra del Runner y volvé a abrir Iniciar-Runner.bat.");
          setRunProgress("fail", "Salió con fallas", errMsg);
          abrirDetalleTecnico(true);
          mostrarEvidenciaActions({ ok: false, error: errMsg, tieneEvidencia: false });
          return;
        }
        setRunProgress("running", esc.titulo);
        iniciarPolling(data.runId, esc.titulo);
      } catch (err) {
        setEjecutando(false);
        const msg = "Error de red: " + err.message;
        mostrarLog(msg);
        setRunProgress("fail", "Salió con fallas", msg);
        abrirDetalleTecnico(true);
        mostrarEvidenciaActions({ ok: false, error: msg, tieneEvidencia: false });
      }
    });

