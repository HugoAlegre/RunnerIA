      if (!bar) return;

      if (clienteStatusTimer) {
        clearTimeout(clienteStatusTimer);
        clienteStatusTimer = null;
      }

      bar.textContent = mensaje;
      bar.className = "status-bar visible " + (tipo || "info");

      if (opts.scroll !== false) {
        bar.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      // Por defecto: mensajes finales son temporales; "en curso" permanece hasta el siguiente.
      const temporal = opts.temporal !== undefined
        ? opts.temporal
        : (tipo === "ok" || tipo === "error" || tipo === "warn");

      if (temporal) {
        const ms = opts.ms || 4500;
        clienteStatusTimer = setTimeout(function () {
          ocultarClienteStatus();
          clienteStatusTimer = null;
        }, ms);
      }
    }

