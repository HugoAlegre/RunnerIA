  <script>
    const API_BASE = "http://localhost:5050";
    const abiertoComoArchivo = window.location.protocol === "file:";
    if (abiertoComoArchivo) {
      document.getElementById("fileWarning").className = "file-warning visible";
    }

    const SUCURSAL = "131 - San Martin";
    const USUARIO = "hugo.alegre";

    const CATEGORIAS = [
      {
        id: "regresion",
        nombre: "Regresión Alta + Intercaja",
        sub: "Todo junto en Pesos: 01 → 02 → 05 → 03 → 04 (sin Caja-Bóveda)",
        escenarios: ["00"]
      },
      {
        id: "alta-caja",
        nombre: "Alta de caja",
        sub: "Pesos, Dolares y Euro — mismo flujo; solo cambia el toggle de moneda (+ supervisión sot1)",
        escenarios: ["01", "02", "02-USD", "02-EUR"]
      },
      {
        id: "intercaja",
        nombre: "Intercaja",
        sub: "Pesos, USD y EUR — detección automática de cajas Normal abiertas en la moneda",
        escenarios: ["05", "03", "04", "03-USD", "04-USD", "03-EUR", "04-EUR"]
      },
      {
