    async function consultarCorrida(runId) {
      const res = await fetch(API_BASE + "/run/" + runId, { cache: "no-store" });
      if (!res.ok) throw new Error("No se pudo consultar la corrida.");
      return res.json();
    }

    function iniciarPolling(runId, titulo) {
      if (pollTimer) clearInterval(pollTimer);
      setRunProgress("running", titulo);
      pollTimer = setInterval(async function () {
        try {
          const data = await consultarCorrida(runId);
          // Actualiza el log en segundo plano (solo se ve si abrís "Detalle técnico").
          if (data.log) mostrarLog(data.log);
          if (data.estado !== "finalizado") return;

          clearInterval(pollTimer);
          pollTimer = null;
          setEjecutando(false);

          if (data.ok) {
            setRunProgress("ok", "OK", "La corrida terminó correctamente.");
            ocultarStatus();
          } else {
            setRunProgress(
              "fail",
              "Salió con fallas",
              "Ver informe para el detalle" + (data.error ? " · " + data.error : "")
            );
            ocultarStatus();
            abrirDetalleTecnico(true);
          }
          mostrarEvidenciaActions(data);
        } catch (err) {
          clearInterval(pollTimer);
          pollTimer = null;
          setEjecutando(false);
          const msg = "No se pudo consultar la corrida: " + err.message;
          mostrarLog(msg);
          setRunProgress("fail", "Salió con fallas", msg);
          abrirDetalleTecnico(true);
          mostrarEvidenciaActions({ ok: false, error: msg, tieneEvidencia: false });
        }
      }, 2000);
    }

    document.getElementById("btnEjecutar").addEventListener("click", async function () {
      const esc = ESCENARIOS[escenarioActual];

      if (!servidorOnline) {
        mostrarStatus("Servidor no disponible. Doble clic en Iniciar-Runner.bat", "warn");
        await abrirSotDialog({
          mode: "alert",
          eyebrow: "Servidor local",
          title: "Runner no disponible",
          confirmLabel: "Entendido",
          bodyHtml:
            "<p>Para ejecutar desde el navegador necesitás el servidor local.</p>" +
            "<div class=\"sot-dialog-meta\">" +
            "<div><span class=\"lbl\">1</span><span class=\"val\">Carpeta RunnerOperador</span></div>" +
            "<div><span class=\"lbl\">2</span><span class=\"val\">Doble clic en Iniciar-Runner.bat</span></div>" +
            "<div><span class=\"lbl\">3</span><span class=\"val\">Abrí http://localhost:5050/</span></div>" +
            "<div><span class=\"lbl\">4</span><span class=\"val\">No cierres la ventana negra</span></div>" +
            "</div>" +
