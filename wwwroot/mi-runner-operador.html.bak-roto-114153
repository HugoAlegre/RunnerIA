          '<small>Escenario ' + esc.num + '</small>' +
          '</div>' +
          '<strong>' + esc.titulo + '</strong>' +
          '<span>' + esc.corto + '</span>' +
          '</div>';
      }).join("");

      cont.querySelectorAll(".scenario").forEach(function (item) {
        item.addEventListener("click", function () {
          escenarioActual = item.getAttribute("data-id");
          renderLista();
          mostrarEscenario(ESCENARIOS[escenarioActual]);
        });
