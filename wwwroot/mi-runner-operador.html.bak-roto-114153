    function cerrarRunnerSelect() {
      const root = document.getElementById("runnerSelect");
      const trigger = document.getElementById("runnerSelectTrigger");
      root.classList.remove("open");
      trigger.setAttribute("aria-expanded", "false");
    }

    function toggleRunnerSelect() {
      const root = document.getElementById("runnerSelect");
      const trigger = document.getElementById("runnerSelectTrigger");
      const open = !root.classList.contains("open");
      root.classList.toggle("open", open);
      trigger.setAttribute("aria-expanded", open ? "true" : "false");
    }

    function renderCategorias() {
      const catActiva = CATEGORIAS.find(function (c) { return c.id === categoriaActual; }) || CATEGORIAS[0];
      const label = document.getElementById("runnerSelectLabel");
      const sub = document.getElementById("runnerSelectSub");
      const menu = document.getElementById("runnerSelectMenu");
      const hint = document.getElementById("catHint");

      label.textContent = catActiva.nombre;
      sub.textContent = catActiva.escenarios.length +
        (catActiva.escenarios.length === 1 ? " escenario" : " escenarios");

      if (catActiva.sub) {
        hint.textContent = catActiva.sub;
        hint.className = "cat-hint visible";
      } else {
        hint.textContent = "";
        hint.className = "cat-hint";
      }

      menu.innerHTML = CATEGORIAS.map(function (cat) {
        const activa = cat.id === categoriaActual ? " active" : "";
        const n = cat.escenarios.length;
        return '<button type="button" class="runner-select-option' + activa + '" role="option" data-cat="' + cat.id + '"' +
          (activa ? ' aria-selected="true"' : ' aria-selected="false"') + '>' +
          '<span class="opt-name">' + escaparAttr(cat.nombre) + '</span>' +
          '<span class="opt-meta">' +
          '<span>' + escaparAttr(cat.sub) + '</span>' +
          '<span class="opt-count">' + n + '</span>' +
          '</span>' +
          '</button>';
      }).join("");

        menu.querySelectorAll(".runner-select-option").forEach(function (btn) {
        btn.addEventListener("click", function () {
          categoriaActual = btn.getAttribute("data-cat");
          const cat = CATEGORIAS.find(function (c) { return c.id === categoriaActual; });
          escenarioActual = (cat.escenarios && cat.escenarios.length) ? cat.escenarios[0] : escenarioActual;
          cerrarRunnerSelect();
          renderCategorias();
          renderLista();
          if (ESCENARIOS[escenarioActual]) mostrarEscenario(ESCENARIOS[escenarioActual]);
        });
      });
    }

    function escaparAttr(s) {
      return String(s || "")
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;")
        .replace(/</g, "&lt;");
    }

    document.getElementById("runnerSelectTrigger").addEventListener("click", function (ev) {
      ev.stopPropagation();
      toggleRunnerSelect();
