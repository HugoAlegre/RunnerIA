    async function cargarListaConfig() {
      const cont = document.getElementById("configFiles");
      if (!servidorOnline) {
        cont.innerHTML = '<div class="config-secret-note">El servidor no está disponible. Iniciá Iniciar-Runner.bat.</div>';
        return;
      }
      try {
        const res = await fetch(API_BASE + "/config/files", { cache: "no-store" });
        configArchivos = await res.json();
        cont.innerHTML = configArchivos.map(function (f) {
          const act = (configActual === f.name) ? " active" : "";
          const miss = f.existe ? "" : " missing";
          return '<button type="button" class="config-file' + act + miss + '" data-name="' + f.name + '"' +
            (f.existe ? "" : " title=\"El archivo no existe todavía\"") + '>' +
            '<span class="fname">' + f.name + '</span>' +
            '<span class="fdesc">' + f.descripcion + (f.existe ? "" : " (no existe)") + '</span>' +
            '</button>';
        }).join("");

        cont.querySelectorAll(".config-file").forEach(function (btn) {
          btn.addEventListener("click", function () {
            abrirConfig(btn.getAttribute("data-name"));
          });
        });
      } catch (err) {
        cont.innerHTML = '<div class="config-secret-note">Error cargando la lista: ' + err.message + '</div>';
      }
    }

    async function abrirConfig(name) {
      const meta = configArchivos.find(function (f) { return f.name === name; });
      if (meta && !meta.existe) {
        mostrarConfigStatus("Ese archivo no existe todavía. Elegí otro.", "warn");
        return;
      }
      try {
        const res = await fetch(API_BASE + "/config/file?name=" + encodeURIComponent(name), { cache: "no-store" });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          mostrarConfigStatus(data.error || "No se pudo abrir el archivo.", "error");
          return;
        }
        configActual = name;
        document.getElementById("configFileName").textContent = name;
        document.getElementById("configFileDesc").textContent = meta ? meta.descripcion : "";
        document.getElementById("configTextarea").value = data.content;
        document.querySelectorAll(".config-file").forEach(function (b) {
          b.classList.toggle("active", b.getAttribute("data-name") === name);
        });

        // Intentar parsear para el modo parametría
        try {
          configObj = JSON.parse(data.content);
          document.getElementById("configModoToggle").style.display = "inline-flex";
          renderParametria();
          aplicarModoConfig("form");
          mostrarConfigStatus("Archivo cargado. Editá los valores y guardá.", "info");
        } catch (e) {
          // Si no parsea, caer al editor JSON crudo
          configObj = null;
          document.getElementById("configModoToggle").style.display = "none";
          aplicarModoConfig("json");
          mostrarConfigStatus("El archivo no es JSON válido; se muestra el editor de texto.", "warn");
        }
      } catch (err) {
        mostrarConfigStatus("Error de red: " + err.message, "error");
      }
    }

    // ----- Modo parametría (formulario) -----
    function esComentario(k) { return k.charAt(0) === "_"; }

    function setEnPath(obj, ruta, valor) {
      let ref = obj;
      for (let i = 0; i < ruta.length - 1; i++) ref = ref[ruta[i]];
      ref[ruta[ruta.length - 1]] = valor;
    }

    function controlHtml(valor, ruta) {
      const rutaAttr = encodeURIComponent(JSON.stringify(ruta));
      if (typeof valor === "boolean") {
        return '<select data-ruta="' + rutaAttr + '" data-tipo="boolean">' +
          '<option value="true"' + (valor ? " selected" : "") + '>Sí (true)</option>' +
          '<option value="false"' + (!valor ? " selected" : "") + '>No (false)</option>' +
          '</select>';
      }
      if (typeof valor === "number") {
        return '<input type="text" inputmode="numeric" data-ruta="' + rutaAttr + '" data-tipo="number" value="' + escaparHtml(String(valor)) + '" />';
      }
      const s = String(valor);
      if (s === "true" || s === "false") {
        return '<select data-ruta="' + rutaAttr + '" data-tipo="boolstring">' +
          '<option value="true"' + (s === "true" ? " selected" : "") + '>Sí (true)</option>' +
          '<option value="false"' + (s === "false" ? " selected" : "") + '>No (false)</option>' +
          '</select>';
      }
      const esLargo = s.length > 55 || s.indexOf("//") !== -1 || s.indexOf("|") !== -1 || s.indexOf("{") !== -1;
      if (esLargo) {
        return '<textarea data-ruta="' + rutaAttr + '" data-tipo="string" spellcheck="false">' + escaparHtml(s) + '</textarea>';
      }
      return '<input type="text" data-ruta="' + rutaAttr + '" data-tipo="string" value="' + escaparHtml(s) + '" />';
    }

    // Convierte un objeto en una lista ordenada de items (campos y notas), asociando
    // los comentarios (_nota…) al campo anterior como texto de ayuda.
    function armarItems(obj) {
      const items = [];
      let ultimoCampo = null;
      Object.keys(obj).forEach(function (k) {
        if (esComentario(k)) {
          const texto = obj[k];
          if (typeof texto !== "string" || texto.trim() === "") return;
          if (ultimoCampo && (k.indexOf("_nota") === 0 || k === "_" + ultimoCampo.key)) {
            ultimoCampo.help.push(texto);
          } else {
            items.push({ tipo: "nota", texto: texto });
            ultimoCampo = null;
          }
        } else {
          const campo = { tipo: "campo", key: k, valor: obj[k], help: [] };
          items.push(campo);
          ultimoCampo = campo;
        }
      });
      return items;
    }

    function esObjetoPlano(v) {
      return v && typeof v === "object" && !Array.isArray(v);
    }

    function renderGrupo(obj, ruta) {
      const items = armarItems(obj);
      let html = "";
      items.forEach(function (it) {
        if (it.tipo === "nota") {
          html += '<div class="param-note">' + escaparHtml(it.texto) + '</div>';
          return;
        }
        const rutaCampo = ruta.concat(it.key);
        if (esObjetoPlano(it.valor)) {
          // Subsección anidada
          const desc = it.valor._seccion || it.valor._paraQueEs || it.valor._nota || "";
          html += '<details class="param-section" open><summary>' + escaparHtml(it.key) +
            (desc ? '<span class="sec-desc">' + escaparHtml(desc) + '</span>' : "") +
            '</summary><div class="param-body">' + renderGrupo(it.valor, rutaCampo) + '</div></details>';
          return;
        }
        if (Array.isArray(it.valor)) {
          const rutaAttr = encodeURIComponent(JSON.stringify(rutaCampo));
          html += '<div class="param-field"><label>' + escaparHtml(it.key) + '</label>' +
            '<textarea data-ruta="' + rutaAttr + '" data-tipo="json" spellcheck="false">' +
            escaparHtml(JSON.stringify(it.valor, null, 2)) + '</textarea></div>';
          return;
        }
        const ayuda = it.help.map(function (h) { return escaparHtml(h); }).join("<br>");
        html += '<div class="param-field"><label>' + escaparHtml(it.key) + '</label>' +
          controlHtml(it.valor, rutaCampo) +
          (ayuda ? '<div class="fhelp">' + ayuda + '</div>' : "") +
          '</div>';
      });
      return html;
    }

    function renderParametria() {
      const cont = document.getElementById("configForm");
      if (!configObj) { cont.innerHTML = ""; return; }
      let html = "";
      if (typeof configObj._instrucciones === "string" && configObj._instrucciones.trim() !== "") {
        html += '<div class="param-intro">' + escaparHtml(configObj._instrucciones) + '</div>';
      }
      // Secciones de primer nivel
      Object.keys(configObj).forEach(function (k) {
        if (esComentario(k)) return;
        const val = configObj[k];
        if (esObjetoPlano(val)) {
          const desc = val._seccion || val._paraQueEs || val._nota || "";
          html += '<details class="param-section" open><summary>' + escaparHtml(k) +
            (desc ? '<span class="sec-desc">' + escaparHtml(desc) + '</span>' : "") +
            '</summary><div class="param-body">' + renderGrupo(val, [k]) + '</div></details>';
        } else {
          // Campo suelto en la raíz
          html += '<div class="param-section"><div class="param-body">' +
            '<div class="param-field"><label>' + escaparHtml(k) + '</label>' + controlHtml(val, [k]) + '</div>' +
            '</div></div>';
        }
      });
      cont.innerHTML = html;
    }

    // Sincroniza cambios del formulario dentro de configObj
    document.getElementById("configForm").addEventListener("input", function (ev) {
      const el = ev.target;
      const rutaAttr = el.getAttribute("data-ruta");
      if (!rutaAttr || !configObj) return;
      const ruta = JSON.parse(decodeURIComponent(rutaAttr));
      const tipo = el.getAttribute("data-tipo");
      let valor = el.value;
      if (tipo === "boolean") valor = (el.value === "true");
      else if (tipo === "number") { const n = Number(el.value); valor = isNaN(n) ? el.value : n; }
      else if (tipo === "json") {
        try { valor = JSON.parse(el.value); el.style.borderColor = ""; }
        catch (e) { el.style.borderColor = "#ef4444"; return; }
      }
      setEnPath(configObj, ruta, valor);
    });

    // ----- Alternar modo formulario / JSON -----
    function aplicarModoConfig(modo) {
      configModo = modo;
      const form = document.getElementById("configForm");
      const ta = document.getElementById("configTextarea");
      const bForm = document.getElementById("btnModoForm");
      const bJson = document.getElementById("btnModoJson");
      if (modo === "json") {
        // Reflejar el objeto actual en el textarea
        if (configObj) ta.value = JSON.stringify(configObj, null, 2);
        form.style.display = "none";
        ta.style.display = "block";
        if (bForm) bForm.classList.remove("active");
        if (bJson) bJson.classList.add("active");
      } else {
        form.style.display = "grid";
        ta.style.display = "none";
        if (bForm) bForm.classList.add("active");
        if (bJson) bJson.classList.remove("active");
      }
    }

    document.getElementById("btnModoForm").addEventListener("click", function () {
      // Al volver al formulario desde JSON, reparsear el texto por si lo editaron
      if (configModo === "json") {
        try {
          configObj = JSON.parse(document.getElementById("configTextarea").value);
          renderParametria();
        } catch (e) {
          mostrarConfigStatus("El JSON del editor no es válido; corregilo antes de volver a la parametría.", "error");
          return;
        }
      }
      aplicarModoConfig("form");
    });

    document.getElementById("btnModoJson").addEventListener("click", function () {
      aplicarModoConfig("json");
    });

    document.getElementById("btnConfigRecargar").addEventListener("click", function () {
      if (configActual) abrirConfig(configActual);
      else mostrarConfigStatus("Primero elegí un archivo de la lista.", "warn");
    });

    document.getElementById("btnConfigGuardar").addEventListener("click", async function () {
      if (!configActual) {
        mostrarConfigStatus("Primero elegí un archivo de la lista.", "warn");
        return;
      }

      let contenido;
      if (configModo === "json" || !configObj) {
        contenido = document.getElementById("configTextarea").value;
        try { JSON.parse(contenido); }
        catch (e) { mostrarConfigStatus("JSON inválido: " + e.message, "error"); return; }
      } else {
        contenido = JSON.stringify(configObj, null, 2);
      }

      try {
        const res = await fetch(API_BASE + "/config/file", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name: configActual, content: contenido })
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          mostrarConfigStatus(data.error || "No se pudo guardar.", "error");
          return;
        }
        mostrarConfigStatus("Guardado correctamente (se creó copia .bak).", "ok");
      } catch (err) {
        mostrarConfigStatus("Error de red: " + err.message, "error");
      }
    });

    // ---------- Vista Ayuda: render de MANUAL.md ----------
    function escaparHtml(s) {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function escaparAttr(s) {
      return escaparHtml(String(s || "")).replace(/"/g, "&quot;");
    }

    function slugManual(texto) {
      return String(texto || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/`([^`]+)`/g, "$1")
        .replace(/<[^>]+>/g, "")
        .replace(/[.:,()[\]{}"'¿?¡!]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    function inline(texto) {
      let t = escaparHtml(texto);
      t = t.replace(/`([^`]+)`/g, "<code>$1</code>");
      t = t.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
      t = t.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function (_, label, href) {
        const safeHref = escaparAttr(href);
        if (href.indexOf("#") === 0) {
          return '<a href="' + safeHref + '" data-manual-anchor="' + safeHref.substring(1) + '">' + label + "</a>";
        }
        return '<a href="' + safeHref + '" target="_blank" rel="noopener">' + label + "</a>";
      });
      return t;
    }

    // Render markdown mínimo: encabezados, listas, tablas, code fences, párrafos.
    function renderMarkdown(md) {
      const lineas = md.replace(/\r\n/g, "\n").split("\n");
      let html = "";
      let i = 0;
      let enLista = false;
      let enOrden = false;

      function cerrarLista() {
        if (enLista) { html += "</ul>"; enLista = false; }
        if (enOrden) { html += "</ol>"; enOrden = false; }
      }

      while (i < lineas.length) {
        const linea = lineas[i];

        // Bloque de código ```
        if (linea.trim().startsWith("```")) {
          cerrarLista();
          i++;
          let code = "";
          while (i < lineas.length && !lineas[i].trim().startsWith("```")) {
            code += escaparHtml(lineas[i]) + "\n";
            i++;
          }
          i++;
          html += "<pre><code>" + code + "</code></pre>";
          continue;
        }

        // Tabla (encabezado seguido de fila |---|)
        if (linea.indexOf("|") !== -1 && i + 1 < lineas.length && /^\s*\|?[\s:|-]+\|?\s*$/.test(lineas[i + 1]) && lineas[i + 1].indexOf("-") !== -1) {
          cerrarLista();
          const encabezados = linea.split("|").map(function (c) { return c.trim(); }).filter(function (c) { return c.length; });
          html += "<table><thead><tr>" + encabezados.map(function (h) { return "<th>" + inline(h) + "</th>"; }).join("") + "</tr></thead><tbody>";
          i += 2;
          while (i < lineas.length && lineas[i].indexOf("|") !== -1) {
            const celdas = lineas[i].split("|").map(function (c) { return c.trim(); }).filter(function (c) { return c.length; });
            html += "<tr>" + celdas.map(function (c) { return "<td>" + inline(c) + "</td>"; }).join("") + "</tr>";
            i++;
          }
          html += "</tbody></table>";
          continue;
        }

        // Encabezados
        const h = linea.match(/^(#{1,4})\s+(.*)$/);
        if (h) {
          cerrarLista();
          const nivel = h[1].length;
          const id = slugManual(h[2]);
          html += "<h" + nivel + ' id="' + escaparAttr(id) + '">' + inline(h[2]) + "</h" + nivel + ">";
          i++;
          continue;
        }

        // Lista ordenada
        if (/^\s*\d+\.\s+/.test(linea)) {
          if (!enOrden) { cerrarLista(); html += "<ol>"; enOrden = true; }
          html += "<li>" + inline(linea.replace(/^\s*\d+\.\s+/, "")) + "</li>";
          i++;
          continue;
        }

        // Lista con viñetas
        if (/^\s*[-*]\s+/.test(linea)) {
          if (!enLista) { cerrarLista(); html += "<ul>"; enLista = true; }
          html += "<li>" + inline(linea.replace(/^\s*[-*]\s+/, "")) + "</li>";
          i++;
          continue;
        }

        // Línea vacía
        if (linea.trim() === "") {
          cerrarLista();
          i++;
          continue;
        }

        // Párrafo
        cerrarLista();
        html += "<p>" + inline(linea) + "</p>";
        i++;
      }
      cerrarLista();
      return html;
    }

    async function cargarManual() {
      const status = document.getElementById("manualStatus");
      const cont = document.getElementById("manualRender");
      try {
        const res = await fetch(API_BASE + "/manual", { cache: "no-store" });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          status.className = "status-bar visible warn";
          status.textContent = data.error || "No se pudo cargar el manual.";
          return;
        }
        cont.innerHTML = renderMarkdown(data.content);
        status.className = "status-bar";
        status.textContent = "";
        manualCargado = true;
      } catch (err) {
        status.className = "status-bar visible warn";
        status.textContent = "No se pudo cargar el manual: " + err.message;
      }
    }

    document.getElementById("manualRender").addEventListener("click", function (ev) {
      const link = ev.target.closest("a[data-manual-anchor]");
      if (!link) return;

      ev.preventDefault();
      const id = link.getAttribute("data-manual-anchor");
      const destino = id ? document.getElementById(id) : null;
      if (!destino) return;

      destino.scrollIntoView({ behavior: "smooth", block: "start" });
      history.replaceState(null, "", "#" + id);
    });

    function medirChrome() {
      const warn = document.getElementById("fileWarning");
      const brand = document.querySelector(".brandbar");
      const head = document.querySelector("header");
      const nav = document.querySelector(".nav");
      let h = 24;
      [warn, brand, head, nav].forEach(function (el) {
        if (!el || (el.id === "fileWarning" && !el.classList.contains("visible"))) return;
        h += el.getBoundingClientRect().height;
      });
      h += parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--app-pad")) * 2 || 32;
      document.documentElement.style.setProperty("--chrome", Math.ceil(h) + "px");
    }

    let resizeTimer = null;
    function onViewportChange() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(medirChrome, 80);
    }

    window.addEventListener("resize", onViewportChange);
    window.addEventListener("orientationchange", onViewportChange);
    if (window.visualViewport) {
      window.visualViewport.addEventListener("resize", onViewportChange);
    }

    function aplicarTema(tema) {
      const t = tema === "dark" ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", t);
      try { localStorage.setItem("sot-runner-theme", t); } catch (_) {}
      document.getElementById("btnThemeLight").classList.toggle("active", t === "light");
      document.getElementById("btnThemeDark").classList.toggle("active", t === "dark");
    }

    (function initTema() {
      let guardado = null;
      try { guardado = localStorage.getItem("sot-runner-theme"); } catch (_) {}
      if (guardado !== "light" && guardado !== "dark") {
        guardado = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark" : "light";
      }
      aplicarTema(guardado);
    })();

    document.getElementById("btnThemeLight").addEventListener("click", function () { aplicarTema("light"); });
    document.getElementById("btnThemeDark").addEventListener("click", function () { aplicarTema("dark"); });

    renderCategorias();
    renderLista();
    mostrarEscenario(ESCENARIOS[escenarioActual]);
    medirChrome();
    verificarServidor().then(function () {
      if (servidorOnline) pilotoCargarEnRunner(null);
    });
    setInterval(verificarServidor, 10000);
  </script>
