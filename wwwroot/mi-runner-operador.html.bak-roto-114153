      const resumenCaso = (document.getElementById("pilotoResumenCaso") && document.getElementById("pilotoResumenCaso").value || "").trim();
      const modoNuevo = !!(document.getElementById("pilotoGrupoModoNuevo") && document.getElementById("pilotoGrupoModoNuevo").checked);
      const grupoId = document.getElementById("pilotoGrupoSelect").value || PILOTO_CAT_ID;
